{
  "manifest_version": 3,
  "name": "Chrome Immersive Fullscreen",
  "version": "1.2.0",
  "minimum_chrome_version": "102",
  "description": "Shows tabs, the address bar, and bookmarks while Chrome is in F11 fullscreen.",
  "homepage_url": "https://github.com/uygarozdemir/Chrome-Immersive-Fullscreen",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Chrome Immersive Fullscreen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "bookmarks",
    "favicon",
    "search",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "_favicon/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
